# Local defaults. Django does not load this file automatically.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=31536000

DJANGO_DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
ORDER_STOCK_RESERVATION_MINUTES=15

# Set s3 in production; local media is the development default.
DJANGO_MEDIA_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Local email defaults to the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Jaunpur Footwear <noreply@example.com>

# Optional payment gateway settings. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API; requires approved template and customer opt-in.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_TEMPLATE=

# Marketplace flows; configure only for approved seller accounts.
MARKETPLACE_TOKEN_ENCRYPTION_KEY=
MARKETPLACE_API_USER_AGENT=JaunpurFootwear/1.0 (Language=Python)
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
FLIPKART_REDIRECT_URI=
AMAZON_APPLICATION_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REDIRECT_URI=
AMAZON_OAUTH_VERSION=
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
ONDC_PARTICIPANT_ADAPTER=

# Scheduled operations checks.
BACKUP_HEALTHCHECK_PATH=
BACKUP_MAX_AGE_HOURS=36
BACKUP_RESTORE_CHECK_INTERVAL_DAYS=90
OPERATIONS_ALERT_EMAILS=

# Default delivery estimate when a shop does not override it.
DEFAULT_DELIVERY_MIN_DAYS=1
DEFAULT_DELIVERY_MAX_DAYS=3
