DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional production database connection; use a managed PostgreSQL URL.
DJANGO_DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
DJANGO_MEDIA_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional for S3-compatible providers such as MinIO or other object storage.
AWS_S3_ENDPOINT_URL=

# Optional Razorpay settings. Keep real keys out of source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
