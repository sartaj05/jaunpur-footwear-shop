DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional production database connection; use a managed PostgreSQL URL.
DJANGO_DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
ORDER_STOCK_RESERVATION_MINUTES=15
BACKUP_HEALTHCHECK_PATH=
BACKUP_MAX_AGE_HOURS=36
BACKUP_RESTORE_CHECK_INTERVAL_DAYS=90
OPERATIONS_ALERT_EMAILS=
DJANGO_MEDIA_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional for S3-compatible providers such as MinIO or other object storage.
AWS_S3_ENDPOINT_URL=

# Optional Razorpay settings. Keep real keys out of source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional dotted Python path for the participant-specific ONDC health-check adapter.
# The adapter implementation should read credentials from the deployment secret store.
ONDC_PARTICIPANT_ADAPTER=
